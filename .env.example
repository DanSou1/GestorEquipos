# Copiar a ".env" (no versionado) y completar antes de "docker compose up".
# El contenedor "web" se conecta al SQL Server que ya corre en el host (no levanta uno
# propio) — ver scripts/create-docker-sql-login.sql para crear este login dedicado.
LOCAL_SQL_USER=gestorequipos_docker
LOCAL_SQL_PASSWORD=

# Credenciales del primer administrador que AuthBootstrapper.EnsureAdminAsync creará
# la primera vez que corra contra una base de datos sin ningún admin. Si tu base de
# datos local (AssetOps) ya tiene un administrador, estas dos quedan sin efecto y
# puedes dejarlas vacías.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Cuenta Gmail usada para enviar las actas de "Mantenimientos Programados" y los avisos
# de caso resuelto del módulo "Casos TI", por correo.
# SMTP_APP_PASSWORD es una contraseña de aplicación de Gmail (no la contraseña normal
# de la cuenta) — se genera en myaccount.google.com/apppasswords con 2FA activado.
SMTP_FROM_ADDRESS=
SMTP_APP_PASSWORD=

# Copiar a ".env" (no versionado) en el servidor y completar antes de "docker compose up".
# Genera una contraseña NUEVA aquí — no reutilices la de tu SQL Server local.

# Contraseña del usuario "sa" del contenedor SQL Server (autocontenido, vive solo dentro
# de este docker-compose). Debe cumplir la política de complejidad de SQL Server
# (mínimo 8 caracteres, mayúsculas, minúsculas, dígitos y símbolos).
SA_PASSWORD=

# Credenciales del primer administrador que AuthBootstrapper.EnsureAdminAsync creará
# en el primer arranque (la base de datos del contenedor empieza vacía). Opcional: si se
# dejan vacías, no se crea el admin inicial y deberá sembrarse manualmente en la base de datos.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

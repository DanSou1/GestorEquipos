@model GestorEquipos.Models.ViewModels.Home.DashboardViewModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="section-header">
    <h1>Dashboard</h1>
</div>

<h2 class="stat-card-row__heading">Equipos</h2>
<div class="stat-card-row">
    <div class="stat-card">
        <div class="stat-card__header">
            <span class="stat-card__icon stat-card__icon--blue">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
            </span>
            <span class="stat-card__label">Total equipos</span>
        </div>
        <div class="stat-card__value">@Model.EquipmentStats.Total</div>
        <div class="stat-card__bar stat-card__bar--blue"></div>
    </div>
    <div class="stat-card">
        <div class="stat-card__header">
            <span class="stat-card__icon stat-card__icon--green">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
            </span>
            <span class="stat-card__label">Activos</span>
        </div>
        <div class="stat-card__value">@Model.EquipmentStats.Activos</div>
        <div class="stat-card__bar stat-card__bar--green"></div>
    </div>
    <div class="stat-card">
        <div class="stat-card__header">
            <span class="stat-card__icon stat-card__icon--violet">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
            </span>
            <span class="stat-card__label">Disponibles</span>
        </div>
        <div class="stat-card__value">@Model.EquipmentStats.Disponibles</div>
        <div class="stat-card__bar stat-card__bar--violet"></div>
    </div>
    <div class="stat-card">
        <div class="stat-card__header">
            <span class="stat-card__icon stat-card__icon--amber">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6h16Z" /></svg>
            </span>
            <span class="stat-card__label">RAES</span>
        </div>
        <div class="stat-card__value">@Model.EquipmentStats.Raes</div>
        <div class="stat-card__bar stat-card__bar--amber"></div>
    </div>
</div>

<h2 class="stat-card-row__heading">Periféricos</h2>
<div class="stat-card-row">
    <div class="stat-card">
        <div class="stat-card__header">
            <span class="stat-card__icon stat-card__icon--blue">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
            </span>
            <span class="stat-card__label">Total periféricos</span>
        </div>
        <div class="stat-card__value">@Model.PeripheralStats.Total</div>
        <div class="stat-card__bar stat-card__bar--blue"></div>
    </div>
    <div class="stat-card">
        <div class="stat-card__header">
            <span class="stat-card__icon stat-card__icon--green">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
            </span>
            <span class="stat-card__label">Activos</span>
        </div>
        <div class="stat-card__value">@Model.PeripheralStats.Activos</div>
        <div class="stat-card__bar stat-card__bar--green"></div>
    </div>
    <div class="stat-card">
        <div class="stat-card__header">
            <span class="stat-card__icon stat-card__icon--violet">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
            </span>
            <span class="stat-card__label">Disponibles</span>
        </div>
        <div class="stat-card__value">@Model.PeripheralStats.Disponibles</div>
        <div class="stat-card__bar stat-card__bar--violet"></div>
    </div>
    <div class="stat-card">
        <div class="stat-card__header">
            <span class="stat-card__icon stat-card__icon--amber">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6h16Z" /></svg>
            </span>
            <span class="stat-card__label">RAES</span>
        </div>
        <div class="stat-card__value">@Model.PeripheralStats.Raes</div>
        <div class="stat-card__bar stat-card__bar--amber"></div>
    </div>
</div>

<div class="charts-row">
    <div class="chart-card">
        <h2 class="chart-card__title">Estado de los equipos</h2>
        <div class="chart-card__body">
            <div class="chart-card__canvas-wrap">
                <canvas id="equipmentStatusChart" role="img" aria-label="Distribución de equipos por estado: activos, disponibles y RAES"></canvas>
            </div>
        </div>
    </div>
    <div class="chart-card">
        <h2 class="chart-card__title">Estado de los periféricos</h2>
        <div class="chart-card__body">
            <div class="chart-card__canvas-wrap">
                <canvas id="peripheralStatusChart" role="img" aria-label="Distribución de periféricos por estado: activos, disponibles y RAES"></canvas>
            </div>
        </div>
    </div>
    <div class="chart-card">
        <h2 class="chart-card__title">Usuarios por regional</h2>
        @if (Model.UsersByRegional.Any())
        {
            <div class="chart-card__body">
                <div class="chart-card__canvas-wrap chart-card__canvas-wrap--bar">
                    <canvas id="usersByRegionalChart" role="img" aria-label="Cantidad de usuarios activos por regional"></canvas>
                </div>
            </div>
        }
        else
        {
            <p class="text-muted mb-0">No hay usuarios activos registrados.</p>
        }
    </div>
</div>

<script id="equipmentStatusChartData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
       {
           labels = new[] { "Activos", "Disponibles", "RAES" },
           values = new[] { Model.EquipmentStats.Activos, Model.EquipmentStats.Disponibles, Model.EquipmentStats.Raes },
           colors = new[] { "#16a34a", "#7c3aed", "#d97706" }
       }))</script>

<script id="peripheralStatusChartData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
       {
           labels = new[] { "Activos", "Disponibles", "RAES" },
           values = new[] { Model.PeripheralStats.Activos, Model.PeripheralStats.Disponibles, Model.PeripheralStats.Raes },
           colors = new[] { "#16a34a", "#7c3aed", "#d97706" }
       }))</script>

<script id="usersByRegionalChartData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
       {
           labels = Model.UsersByRegional.Select(r => r.RegionalName).ToArray(),
           values = Model.UsersByRegional.Select(r => r.Count).ToArray()
       }))</script>

@section Scripts {
    <script src="~/lib/chartjs/dist/chart.umd.min.js"></script>
    <script src="~/js/dashboard-chart.js" asp-append-version="true"></script>
}

@model PeripheralObservationCreateViewModel
@{
    ViewData["Title"] = "Registrar novedad de periférico";
    int peripheralId = ViewBag.PeripheralId;
    int desktopId = ViewBag.DesktopId;
}

<h1>Registrar novedad de periférico</h1>

<form asp-controller="Peripheral" asp-action="AddObservation" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="peripheralId" value="@peripheralId" />
    <input type="hidden" name="desktopId" value="@desktopId" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Date" class="form-label"></label>
        <input asp-for="Date" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Type" class="form-label">Tipo de novedad</label>
        <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<PeripheralObservationType>()"></select>
        <div class="form-text">Baja RAES marca el periférico como desechado. Reparación lo vuelve a marcar como Activo. Cambio solo deja constancia (el estado no cambia automáticamente).</div>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label">Observación</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-controller="Desktop" asp-action="Details" asp-route-id="@desktopId" class="btn btn-link">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

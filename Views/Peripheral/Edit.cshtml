@model GestorEquipos.Models.ViewModels.Peripheral.PeripheralEditViewModel
@{
    ViewData["Title"] = "Editar periférico";
}

<h1>Editar periférico</h1>

<form asp-controller="Peripheral" asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @if (Model.DesktopId.HasValue)
    {
        <input type="hidden" asp-for="DesktopId" />
    }
    else
    {
        <div class="mb-3">
            <label asp-for="DesktopId" class="form-label">Vincular a un equipo (periférico sin equipo asignado)</label>
            <select asp-for="DesktopId" class="form-select" asp-items="ViewBag.Desktops">
                <option value="">-- Dejar sin vincular --</option>
            </select>
            <span asp-validation-for="DesktopId" class="text-danger"></span>
        </div>
    }

    <div class="mb-3">
        <label asp-for="PeripheralTypeId" class="form-label">Tipo</label>
        <select asp-for="PeripheralTypeId" class="form-select" asp-items="ViewBag.PeripheralTypes">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="PeripheralTypeId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Brand" class="form-label">Marca</label>
        <input asp-for="Brand" class="form-control" />
        <span asp-validation-for="Brand" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Model" class="form-label">Modelo</label>
        <input asp-for="Model" class="form-control" />
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Serial" class="form-label">Serial (opcional, a veces ilegible por desgaste)</label>
        <input asp-for="Serial" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    @if (Model.DesktopId.HasValue)
    {
        <a asp-controller="Desktop" asp-action="Details" asp-route-id="@Model.DesktopId" class="btn btn-link">Cancelar</a>
    }
    else
    {
        <a asp-controller="Peripheral" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancelar</a>
    }
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

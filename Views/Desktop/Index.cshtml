@model List<DesktopListViewModel>
@{
    ViewData["Title"] = "Equipos";
    bool? estadoFiltro = ViewBag.EstadoFiltro;
    string? searchTerm = ViewBag.SearchTerm;
}

<div class="section-header">
    <h1>Equipos</h1>
    @if (User.IsInRole("Administrador"))
    {
        <a asp-controller="Desktop" asp-action="Create" class="btn-app-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
            Nuevo equipo
        </a>
    }
</div>

<div class="stat-card-row">
    <div class="stat-card">
        <div class="stat-card__header">
            <span class="stat-card__icon stat-card__icon--blue">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
            </span>
            <span class="stat-card__label">Total equipos</span>
        </div>
        <div class="stat-card__value">@ViewBag.TotalCount</div>
        <div class="stat-card__bar stat-card__bar--blue"></div>
    </div>
    <div class="stat-card">
        <div class="stat-card__header">
            <span class="stat-card__icon stat-card__icon--green">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
            </span>
            <span class="stat-card__label">Activos</span>
        </div>
        <div class="stat-card__value">@ViewBag.ActivosCount</div>
        <div class="stat-card__bar stat-card__bar--green"></div>
    </div>
    <div class="stat-card">
        <div class="stat-card__header">
            <span class="stat-card__icon stat-card__icon--gray">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>
            </span>
            <span class="stat-card__label">Inactivos</span>
        </div>
        <div class="stat-card__value">@ViewBag.InactivosCount</div>
        <div class="stat-card__bar stat-card__bar--gray"></div>
    </div>
</div>

<form method="get" class="app-toolbar">
    <div class="app-toolbar__search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
        <input type="search" name="search" value="@searchTerm" class="form-control" placeholder="Buscar equipo..." />
    </div>
    <select name="estado" class="form-select" style="max-width: 180px;" onchange="this.form.submit()">
        <option value="" selected="@(estadoFiltro == null)">Todos</option>
        <option value="true" selected="@(estadoFiltro == true)">Activo</option>
        <option value="false" selected="@(estadoFiltro == false)">Inactivo / RAES</option>
    </select>
</form>

<div class="app-card">
    <table class="app-table">
        <thead>
            <tr>
                <th>Nombre de equipo</th>
                <th>Serial</th>
                <th>Usuario asignado</th>
                <th>Área</th>
                <th>Regional</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.NameDesktop</td>
                    <td>@item.SerialNumber</td>
                    <td>@item.UserName</td>
                    <td>@item.AreaName</td>
                    <td>@item.RegionalName</td>
                    <td>
                        <span class="badge-estado @(item.Status == "Activo" ? "badge-estado--activo" : "badge-estado--inactivo")">@item.Status</span>
                    </td>
                    <td>
                        <a asp-controller="Desktop" asp-action="Details" asp-route-id="@item.Id">Ver hoja de vida</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <p class="text-muted p-3 mb-0">No hay equipos registrados.</p>
    }
</div>

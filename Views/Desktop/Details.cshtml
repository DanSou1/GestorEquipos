@model DesktopDetailViewModel
@{
    ViewData["Title"] = $"Hoja de vida - {Model.NameDesktop}";
    string? error = ViewBag.Error;
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Model.NameDesktop</h1>
    <div class="d-flex align-items-center gap-2">
        <span class="badge @(Model.Estado ? "bg-success" : "bg-secondary") fs-6">@(Model.Estado ? "Activo" : "Inactivo")</span>
        @if (User.IsInRole("Administrador"))
        {
            <a asp-controller="Desktop" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
            <a asp-controller="Desktop" asp-action="Assign" asp-route-desktopId="@Model.Id" class="btn btn-sm btn-outline-primary">Asignar</a>
            @if (Model.Estado)
            {
                <form asp-controller="Desktop" asp-action="Deactivate" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('¿Enviar este equipo a RAES? Esta acción no se puede deshacer.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger">Enviar a RAES</button>
                </form>
            }
            <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteDesktopModal">Eliminar</button>
        }
    </div>
</div>

@if (User.IsInRole("Administrador"))
{
    <div class="modal fade" id="deleteDesktopModal" tabindex="-1" aria-labelledby="deleteDesktopModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteDesktopModalLabel">Eliminar hoja de vida</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    ¿Desea eliminar esta hoja de vida?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <form asp-controller="Desktop" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header">Especificaciones</div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item"><strong>Serial:</strong> @Model.SerialNumber</li>
                <li class="list-group-item"><strong>Marca / Modelo:</strong> @Model.Brand / @Model.Model</li>
                <li class="list-group-item"><strong>Procesador:</strong> @Model.Processor</li>
                <li class="list-group-item"><strong>Disco:</strong> @Model.Disk</li>
                <li class="list-group-item"><strong>Sistema Operativo:</strong> @Model.OSVersionName</li>
                <li class="list-group-item"><strong>RAM:</strong> @Model.RamSpecification</li>
                @if (User.IsInRole("Administrador"))
                {
                    <li class="list-group-item">
                        <strong>Acceso remoto:</strong>
                        @if (Model.RemoteAccess is null)
                        {
                            @:No configurado
                        }
                        else if (Model.RemoteAccess.ConnectionType == RemoteConnectionType.Aplicativo)
                        {
                            @:Aplicativo — @Model.RemoteAccess.AppDescription
                        }
                        else
                        {
                            @:RDP — @Model.RemoteAccess.IPAddress:@Model.RemoteAccess.Port (@Model.RemoteAccess.Username)
                            <button type="button" class="btn btn-sm btn-link p-0 ms-1" id="toggleRemotePassword" data-password="@Model.RemoteAccess.Password">mostrar clave</button>
                            <span id="remotePasswordValue" class="ms-1 text-muted"></span>
                        }
                    </li>
                }
            </ul>
        </div>

        <div class="card mb-3">
            <div class="card-header">Asignación actual</div>
            <div class="card-body">
                <p class="mb-1"><strong>Usuario:</strong> @Model.CurrentUserName</p>
                @if (Model.CurrentUserName == "Disponible" && Model.CurrentSinceDate is not null)
                {
                    <p class="mb-1 text-muted small">Disponible desde @Model.CurrentSinceDate.Value.ToString("yyyy-MM-dd")</p>
                }
                <p class="mb-1"><strong>Área:</strong> @Model.CurrentAreaName</p>
                <p class="mb-0"><strong>Regional:</strong> @Model.CurrentRegionalName</p>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Historial de asignaciones</div>
            <ul class="list-group list-group-flush">
                @foreach (var a in Model.AsignationHistory)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span>@a.UserName</span>
                        <span class="text-muted">@a.DateAsignation.ToString("yyyy-MM-dd")</span>
                    </li>
                }
                @if (!Model.AsignationHistory.Any())
                {
                    <li class="list-group-item text-muted">Sin historial de asignaciones.</li>
                }
            </ul>
        </div>

        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                Licencias
                @if (User.IsInRole("Administrador"))
                {
                    <a asp-controller="License" asp-action="Create" asp-route-desktopId="@Model.Id" class="btn btn-sm btn-outline-primary">Agregar licencia</a>
                }
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var l in Model.Licenses)
                {
                    <li class="list-group-item">
                        <strong>@l.SoftwareType</strong>
                        @if (l.NoLicense)
                        {
                            <span class="badge bg-warning text-dark ms-2">Sin licencia</span>
                        }
                        else
                        {
                            <span class="text-muted ms-2">@l.LicenseKey</span>
                        }
                    </li>
                }
                @if (!Model.Licenses.Any())
                {
                    <li class="list-group-item text-muted">Sin licencias registradas.</li>
                }
            </ul>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                Periféricos
                @if (User.IsInRole("Administrador"))
                {
                    <a asp-controller="Peripheral" asp-action="Create" asp-route-desktopId="@Model.Id" class="btn btn-sm btn-outline-primary">Agregar periférico</a>
                }
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var p in Model.Peripherals)
                {
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong>@p.TypeName</strong> — @p.Brand @p.Model
                                @if (!string.IsNullOrWhiteSpace(p.Serial))
                                {
                                    <span class="text-muted">(Serial: @p.Serial)</span>
                                }
                                <br />
                                <span class="badge @(p.Estado == "Activo" ? "bg-success" : p.Estado == "Raes" ? "bg-dark" : "bg-secondary")">@p.Estado</span>
                                <a asp-controller="Peripheral" asp-action="Details" asp-route-id="@p.Id" class="ms-2 small">Ver detalle</a>
                            </div>
                            @if (User.IsInRole("Administrador"))
                            {
                                <div class="d-flex flex-column align-items-end gap-1">
                                    <a asp-controller="Peripheral" asp-action="Reassign" asp-route-peripheralId="@p.Id" class="btn btn-sm btn-outline-primary">Reasignar</a>
                                    <div>
                                        <a asp-controller="Peripheral" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-link p-0">Editar</a>
                                        <button type="button" class="btn btn-sm btn-link p-0 text-danger ms-2" data-bs-toggle="modal" data-bs-target="#deletePeripheralModal-@p.Id">Eliminar</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </li>

                    @if (User.IsInRole("Administrador"))
                    {
                        <div class="modal fade" id="deletePeripheralModal-@p.Id" tabindex="-1" aria-labelledby="deletePeripheralModalLabel-@p.Id" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <form asp-controller="Peripheral" asp-action="Delete" asp-route-id="@p.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="desktopId" value="@Model.Id" />
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="deletePeripheralModalLabel-@p.Id">Eliminar periférico</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                        </div>
                                        <div class="modal-body">
                                            <p>¿Desea eliminar <strong>@p.TypeName — @p.Brand @p.Model</strong>?</p>
                                            <div class="mb-2">
                                                <label class="form-label">Tu contraseña de Administrador</label>
                                                <input type="password" name="adminPassword" class="form-control" autocomplete="current-password" required />
                                                <div class="form-text">Requerida únicamente para confirmar la eliminación.</div>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                            <button type="submit" class="btn btn-danger">Eliminar</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
                @if (!Model.Peripherals.Any())
                {
                    <li class="list-group-item text-muted">Sin periféricos registrados.</li>
                }
            </ul>
        </div>

        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                Historial de mantenimiento
                @if (User.IsInRole("Administrador"))
                {
                    <a asp-controller="Maintenance" asp-action="Create" asp-route-desktopId="@Model.Id" class="btn btn-sm btn-outline-primary">Registrar mantenimiento</a>
                }
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var m in Model.Maintenances)
                {
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between">
                            <strong>@m.MaintenanceTypeName</strong>
                            <span class="text-muted">@m.Date.ToString("yyyy-MM-dd")</span>
                        </div>
                        <div>@m.Description</div>
                        <div class="small text-muted">Técnico: @m.TechnicianName</div>
                    </li>
                }
                @if (!Model.Maintenances.Any())
                {
                    <li class="list-group-item text-muted">Sin mantenimientos registrados.</li>
                }
            </ul>
        </div>

        <div class="card mb-3">
            <div class="card-header">Historial de cambios de especificaciones</div>
            <ul class="list-group list-group-flush">
                @foreach (var s in Model.SpecChangeLogs)
                {
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between">
                            <strong>@s.FieldName</strong>
                            <span class="text-muted">@s.Date.ToString("yyyy-MM-dd")</span>
                        </div>
                        <div class="small">@(s.OldValue ?? "—") → @(s.NewValue ?? "—")</div>
                        <div class="small text-muted">Por: @s.ChangedByName</div>
                    </li>
                }
                @if (!Model.SpecChangeLogs.Any())
                {
                    <li class="list-group-item text-muted">Sin cambios registrados.</li>
                }
            </ul>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center">
    <a asp-controller="Desktop" asp-action="Index" class="btn btn-link">&larr; Volver al listado</a>
    <a asp-controller="Desktop" asp-action="DownloadPdf" asp-route-id="@Model.Id" class="btn btn-outline-primary">Descargar PDF</a>
</div>

@if (User.IsInRole("Administrador") && Model.RemoteAccess is { ConnectionType: RemoteConnectionType.EscritorioRemotoWindows })
{
    @section Scripts {
        <script>
            (function () {
                var toggleBtn = document.getElementById('toggleRemotePassword');
                var valueSpan = document.getElementById('remotePasswordValue');
                toggleBtn.addEventListener('click', function () {
                    var showing = valueSpan.textContent.length > 0;
                    valueSpan.textContent = showing ? '' : toggleBtn.getAttribute('data-password');
                    toggleBtn.textContent = showing ? 'mostrar clave' : 'ocultar clave';
                });
            })();
        </script>
    }
}

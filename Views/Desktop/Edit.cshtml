@model DesktopEditViewModel
@{
    ViewData["Title"] = "Editar equipo";
    int desktopId = ViewBag.DesktopId;
}

<h1>Editar equipo</h1>
<p class="text-muted">Los cambios en las especificaciones quedan registrados en el historial de cambios de la hoja de vida.</p>

<form asp-controller="Desktop" asp-action="Edit" asp-route-id="@desktopId" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="NameDesktop" class="form-label">Nombre de equipo</label>
            <input asp-for="NameDesktop" class="form-control" />
            <span asp-validation-for="NameDesktop" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="SerialNumber" class="form-label">Serial del equipo</label>
            <input asp-for="SerialNumber" class="form-control" />
            <span asp-validation-for="SerialNumber" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Brand" class="form-label">Marca del equipo</label>
            <input asp-for="Brand" class="form-control" />
            <span asp-validation-for="Brand" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Model" class="form-label">Modelo del equipo</label>
            <input asp-for="Model" class="form-control" />
            <span asp-validation-for="Model" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Processor" class="form-label">Tipo de procesador</label>
            <input asp-for="Processor" class="form-control" />
            <span asp-validation-for="Processor" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Disk" class="form-label">Tipo de disco y capacidad</label>
            <input asp-for="Disk" class="form-control" />
            <span asp-validation-for="Disk" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="OSVersionId" class="form-label">Sistema Operativo</label>
            <select asp-for="OSVersionId" class="form-select" asp-items="ViewBag.OSVersions"></select>
            <span asp-validation-for="OSVersionId" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="RamId" class="form-label">RAM</label>
            <select asp-for="RamId" class="form-select" asp-items="ViewBag.Rams"></select>
            <span asp-validation-for="RamId" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="RemoteSelection" class="form-label">Acceso remoto (opcional)</label>
            <select asp-for="RemoteSelection" id="remoteSelection" class="form-select" asp-items="ViewBag.Remotes">
                <option value="">-- Ninguno --</option>
            </select>
            <span asp-validation-for="RemoteSelection" class="text-danger"></span>
        </div>
    </div>

    <div id="newRemoteFields" class="border rounded p-3 mt-3" style="display: none;">
        <h6>Nuevo acceso remoto</h6>
        <p class="text-muted small">Para cambiar los datos de un acceso remoto ya creado, selecciona "+ Crear nuevo acceso remoto" y captúralos de nuevo; no se editan en línea.</p>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="NewRemoteConnectionType" class="form-label">Tipo de conexión</label>
                <select asp-for="NewRemoteConnectionType" id="newRemoteConnectionType" class="form-select">
                    <option value="">-- Selecciona --</option>
                    <option value="Aplicativo">Aplicativo</option>
                    <option value="EscritorioRemotoWindows">Escritorio remoto de Windows (RDP)</option>
                </select>
                <span asp-validation-for="NewRemoteConnectionType" class="text-danger"></span>
            </div>
        </div>

        <div id="newRemoteAplicativoFields" class="row g-3 mt-1" style="display: none;">
            <div class="col-md-8">
                <label asp-for="NewRemoteAppDescription" class="form-label">Nombre del aplicativo o URL</label>
                <input asp-for="NewRemoteAppDescription" class="form-control" />
                <span asp-validation-for="NewRemoteAppDescription" class="text-danger"></span>
            </div>
        </div>

        <div id="newRemoteRdpFields" class="row g-3 mt-1" style="display: none;">
            <div class="col-md-3">
                <label asp-for="NewRemoteIPAddress" class="form-label">IP</label>
                <input asp-for="NewRemoteIPAddress" class="form-control" placeholder="10.0.0.5" />
                <span asp-validation-for="NewRemoteIPAddress" class="text-danger"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="NewRemotePort" class="form-label">Puerto</label>
                <input asp-for="NewRemotePort" class="form-control" placeholder="3389" />
                <span asp-validation-for="NewRemotePort" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="NewRemoteUsername" class="form-label">Usuario</label>
                <input asp-for="NewRemoteUsername" class="form-control" placeholder="NOMBREEQUIPO\usuario" />
                <span asp-validation-for="NewRemoteUsername" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="NewRemotePassword" class="form-label">Clave</label>
                <div class="input-group">
                    <input asp-for="NewRemotePassword" type="password" id="newRemotePassword" class="form-control" />
                    <button type="button" class="btn btn-outline-secondary" id="toggleNewRemotePassword">Mostrar</button>
                </div>
                <span asp-validation-for="NewRemotePassword" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a asp-controller="Desktop" asp-action="Details" asp-route-id="@desktopId" class="btn btn-link">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_RemoteFieldsScriptsPartial" />
}

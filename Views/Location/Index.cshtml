@using GestorEquipos.Models
@{
    ViewData["Title"] = "Áreas y Regionales";
    var areas = (List<Area>)ViewBag.Areas;
    var regionals = (List<Regional>)ViewBag.Regionals;
    string? error = ViewBag.Error;
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}

<div class="section-header">
    <h1>Áreas</h1>
    <a asp-controller="Location" asp-action="CreateArea" class="btn-app-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
        Nueva área
    </a>
</div>

<div class="app-card mb-4">
    <table class="app-table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in areas)
            {
                <tr>
                    <td>@a.Name</td>
                    <td>
                        <a asp-controller="Location" asp-action="EditArea" asp-route-id="@a.Id">Editar</a>
                        <button type="button" class="btn btn-sm btn-outline-danger ms-2" data-bs-toggle="modal" data-bs-target="#deleteAreaModal-@a.Id">Eliminar</button>
                    </td>
                </tr>

                <div class="modal fade" id="deleteAreaModal-@a.Id" tabindex="-1" aria-labelledby="deleteAreaModalLabel-@a.Id" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form asp-controller="Location" asp-action="DeleteArea" asp-route-id="@a.Id" method="post">
                                @Html.AntiForgeryToken()
                                <div class="modal-header">
                                    <h5 class="modal-title" id="deleteAreaModalLabel-@a.Id">Eliminar área</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                </div>
                                <div class="modal-body">
                                    <p>¿Desea eliminar el área <strong>@a.Name</strong>?</p>
                                    <p class="text-muted small">Los usuarios que aún tengan esta área asignada quedarán sin área (podrás reasignarlos después sin problema).</p>
                                    <div class="mb-2">
                                        <label class="form-label">Tu contraseña de Administrador</label>
                                        <input type="password" name="adminPassword" class="form-control" autocomplete="current-password" required />
                                        <div class="form-text">Requerida únicamente para confirmar la eliminación.</div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <button type="submit" class="btn btn-danger">Eliminar</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </tbody>
    </table>

    @if (!areas.Any())
    {
        <p class="text-muted p-3 mb-0">No hay áreas registradas.</p>
    }
</div>

<div class="section-header">
    <h1>Regionales</h1>
    <a asp-controller="Location" asp-action="CreateRegional" class="btn-app-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
        Nueva regional
    </a>
</div>

<div class="app-card">
    <table class="app-table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in regionals)
            {
                <tr>
                    <td>@r.Name</td>
                    <td>
                        <a asp-controller="Location" asp-action="EditRegional" asp-route-id="@r.Id">Editar</a>
                        <button type="button" class="btn btn-sm btn-outline-danger ms-2" data-bs-toggle="modal" data-bs-target="#deleteRegionalModal-@r.Id">Eliminar</button>
                    </td>
                </tr>

                <div class="modal fade" id="deleteRegionalModal-@r.Id" tabindex="-1" aria-labelledby="deleteRegionalModalLabel-@r.Id" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form asp-controller="Location" asp-action="DeleteRegional" asp-route-id="@r.Id" method="post">
                                @Html.AntiForgeryToken()
                                <div class="modal-header">
                                    <h5 class="modal-title" id="deleteRegionalModalLabel-@r.Id">Eliminar regional</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                </div>
                                <div class="modal-body">
                                    <p>¿Desea eliminar la regional <strong>@r.Name</strong>?</p>
                                    <p class="text-muted small">Los usuarios que aún tengan esta regional asignada quedarán sin regional (podrás reasignarlos después sin problema).</p>
                                    <div class="mb-2">
                                        <label class="form-label">Tu contraseña de Administrador</label>
                                        <input type="password" name="adminPassword" class="form-control" autocomplete="current-password" required />
                                        <div class="form-text">Requerida únicamente para confirmar la eliminación.</div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <button type="submit" class="btn btn-danger">Eliminar</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </tbody>
    </table>

    @if (!regionals.Any())
    {
        <p class="text-muted p-3 mb-0">No hay regionales registradas.</p>
    }
</div>

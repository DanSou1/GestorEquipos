@model RemoteEditViewModel
@{
    ViewData["Title"] = "Editar acceso remoto";
    int remoteId = ViewBag.RemoteId;
}

<h1>Editar acceso remoto</h1>

<form asp-controller="Remote" asp-action="Edit" asp-route-id="@remoteId" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="ConnectionType" class="form-label">Tipo de conexión</label>
            <select asp-for="ConnectionType" id="editConnectionType" class="form-select">
                <option value="Aplicativo">Aplicativo</option>
                <option value="EscritorioRemotoWindows">Escritorio remoto de Windows (RDP)</option>
            </select>
            <span asp-validation-for="ConnectionType" class="text-danger"></span>
        </div>
    </div>

    <div id="editAplicativoFields" class="row g-3 mt-1">
        <div class="col-md-8">
            <label asp-for="AppDescription" class="form-label">Nombre del aplicativo o URL</label>
            <input asp-for="AppDescription" class="form-control" />
            <span asp-validation-for="AppDescription" class="text-danger"></span>
        </div>
    </div>

    <div id="editRdpFields" class="row g-3 mt-1">
        <div class="col-md-3">
            <label asp-for="IPAddress" class="form-label">IP</label>
            <input asp-for="IPAddress" class="form-control" placeholder="10.0.0.5" />
            <span asp-validation-for="IPAddress" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Port" class="form-label">Puerto</label>
            <input asp-for="Port" class="form-control" placeholder="3389" />
            <span asp-validation-for="Port" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Username" class="form-label">Usuario</label>
            <input asp-for="Username" class="form-control" placeholder="NOMBREEQUIPO\usuario" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Password" class="form-label">Clave</label>
            <div class="input-group">
                <input asp-for="Password" type="password" id="editPassword" class="form-control" />
                <button type="button" class="btn btn-outline-secondary" id="toggleEditPassword">Mostrar</button>
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a asp-controller="Remote" asp-action="Details" asp-route-id="@remoteId" class="btn btn-link">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_RemoteEditFieldsScriptsPartial" />
}

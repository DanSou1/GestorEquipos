@model List<Users>
@{
    ViewData["Title"] = "Cuentas de acceso";
    string? error = ViewBag.Error;
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}

<div class="section-header">
    <h1>Cuentas de acceso</h1>
    <a asp-controller="AccessAccount" asp-action="Create" class="btn-app-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
        Nueva cuenta
    </a>
</div>

<div class="app-card">
    <table class="app-table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Usuario</th>
                <th>Rol</th>
                <th>Área</th>
                <th>Regional</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                var us = u.UserSystems.First();
                <tr>
                    <td>@u.Name @u.LastName</td>
                    <td>@u.Email</td>
                    <td>@us.Username</td>
                    <td>@us.Rol?.Name</td>
                    <td>@u.Area?.Name</td>
                    <td>@u.Regional?.Name</td>
                    <td>
                        <a asp-controller="AccessAccount" asp-action="Edit" asp-route-id="@u.Id">Editar</a>
                        <button type="button" class="btn btn-sm btn-outline-danger ms-2" data-bs-toggle="modal" data-bs-target="#deleteAccountModal-@u.Id">Eliminar</button>
                    </td>
                </tr>

                <div class="modal fade" id="deleteAccountModal-@u.Id" tabindex="-1" aria-labelledby="deleteAccountModalLabel-@u.Id" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form asp-controller="AccessAccount" asp-action="Delete" asp-route-id="@u.Id" method="post">
                                @Html.AntiForgeryToken()
                                <div class="modal-header">
                                    <h5 class="modal-title" id="deleteAccountModalLabel-@u.Id">Eliminar cuenta de acceso</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                </div>
                                <div class="modal-body">
                                    <p>¿Desea eliminar definitivamente la cuenta de <strong>@u.Name @u.LastName</strong> (@us.Username)?</p>
                                    <div class="mb-2">
                                        <label class="form-label">Tu contraseña de Administrador</label>
                                        <input type="password" name="adminPassword" class="form-control" autocomplete="current-password" required aria-label="Contraseña de administrador" />
                                        <div class="form-text">Requerida únicamente para confirmar la eliminación.</div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <button type="submit" class="btn btn-danger">Eliminar</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <p class="text-muted p-3 mb-0">No hay cuentas de acceso registradas.</p>
    }
</div>

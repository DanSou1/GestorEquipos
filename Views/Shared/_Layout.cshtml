@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool IsActive(params string[] controllers) =>
        controllers.Any(c => string.Equals(c, currentController, StringComparison.OrdinalIgnoreCase));

    bool IsActiveAction(string controller, string action) =>
        string.Equals(controller, currentController, StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, currentAction, StringComparison.OrdinalIgnoreCase);

    bool equiposGroupExpanded = IsActive("Desktop", "DesktopType", "MaintenanceType", "MaintenanceCampaign");
    bool perifericosGroupExpanded = IsActive("Peripheral", "PeripheralType");
    bool casosTIGroupExpanded = IsActive("CasoTI", "TipoCaso", "CasoTIRating");
    bool usuariosGroupExpanded = IsActive("UserAdmin", "Remote", "Location", "Cargo");
    bool isAdminOrTecnico = User.IsInRole("Administrador") || User.IsInRole("Técnico en Sistemas");
    bool isColaborador = User.IsInRole("Colaborador");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestor de Equipos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <script>
        // Aplica la preferencia de sidebar contraído (localStorage) antes del primer render
        // para evitar un parpadeo (expandido -> contraído) al cargar la página.
        (function () {
            if (localStorage.getItem('ge_sidebar_collapsed') === '1' && window.matchMedia('(min-width: 769px)').matches) {
                document.documentElement.classList.add('sidebar-collapsed');
            }
        })();
    </script>
</head>
<body class="app-shell">
    <div class="app-layout">
        <aside class="app-sidebar">
            <div class="app-sidebar__logo">
                <img src="~/Images/logo-exro.webp" alt="Exro" />
            </div>

            <div class="app-sidebar__profile">
                <span class="app-sidebar__avatar">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                </span>
                <span class="app-sidebar__nav-label">
                    <span class="app-sidebar__profile-name d-block">@User.Identity?.Name</span>
                    <span class="app-sidebar__profile-role">@(User.IsInRole("Administrador") ? "Admin" : User.IsInRole("Técnico en Sistemas") ? "Técnico" : isColaborador ? "Colaborador" : "Auditor")</span>
                </span>
            </div>

            <ul class="app-sidebar__nav">
                @if (!isColaborador)
                {
                    <li>
                        <a class="app-sidebar__nav-link @(IsActive("Home") ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index" title="Dashboard">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /></svg>
                            <span class="app-sidebar__nav-label">Dashboard</span>
                        </a>
                    </li>
                }
                @if (isColaborador)
                {
                    <li>
                        <a class="app-sidebar__nav-link @(IsActive("CasoTI") ? "active" : "")" asp-area="" asp-controller="CasoTI" asp-action="Index" title="Casos TI">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                            <span class="app-sidebar__nav-label">Casos TI</span>
                        </a>
                    </li>
                }
                else if (isAdminOrTecnico)
                {
                    <li class="app-sidebar__nav-group @(equiposGroupExpanded ? "is-expanded" : "")" data-nav-group="equipos">
                        <div class="app-sidebar__nav-row">
                            <a class="app-sidebar__nav-link @(IsActive("Desktop") ? "active" : "")" asp-area="" asp-controller="Desktop" asp-action="Index" title="Equipos">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
                                <span class="app-sidebar__nav-label">Equipos</span>
                            </a>
                            <button type="button" class="app-sidebar__nav-chevron" aria-expanded="@(equiposGroupExpanded ? "true" : "false")" aria-controls="submenu-equipos" title="Mostrar/ocultar submenú de Equipos">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                            </button>
                        </div>
                        <ul class="app-sidebar__submenu" id="submenu-equipos">
                            <li>
                                <a class="app-sidebar__submenu-link @(IsActive("MaintenanceCampaign") ? "active" : "")" asp-area="" asp-controller="MaintenanceCampaign" asp-action="Index">Mantenimientos Programados</a>
                            </li>
                            <li>
                                <a class="app-sidebar__submenu-link @(IsActive("MaintenanceType") ? "active" : "")" asp-area="" asp-controller="MaintenanceType" asp-action="Index">Tipos de mantenimiento</a>
                            </li>
                            <li>
                                <a class="app-sidebar__submenu-link @(IsActive("DesktopType") ? "active" : "")" asp-area="" asp-controller="DesktopType" asp-action="Index">Tipos de equipo</a>
                            </li>
                        </ul>
                    </li>
                    <li class="app-sidebar__nav-group @(perifericosGroupExpanded ? "is-expanded" : "")" data-nav-group="perifericos">
                        <div class="app-sidebar__nav-row">
                            <a class="app-sidebar__nav-link @(IsActive("Peripheral") ? "active" : "")" asp-area="" asp-controller="Peripheral" asp-action="Index" title="Periféricos">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" /></svg>
                                <span class="app-sidebar__nav-label">Periféricos</span>
                            </a>
                            <button type="button" class="app-sidebar__nav-chevron" aria-expanded="@(perifericosGroupExpanded ? "true" : "false")" aria-controls="submenu-perifericos" title="Mostrar/ocultar submenú de Periféricos">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                            </button>
                        </div>
                        <ul class="app-sidebar__submenu" id="submenu-perifericos">
                            <li>
                                <a class="app-sidebar__submenu-link @(IsActive("PeripheralType") ? "active" : "")" asp-area="" asp-controller="PeripheralType" asp-action="Index">Tipos de periférico</a>
                            </li>
                        </ul>
                    </li>
                    <li class="app-sidebar__nav-group @(casosTIGroupExpanded ? "is-expanded" : "")" data-nav-group="casos-ti">
                        <div class="app-sidebar__nav-row">
                            <a class="app-sidebar__nav-link @(IsActive("CasoTI") ? "active" : "")" asp-area="" asp-controller="CasoTI" asp-action="Index" title="Casos TI">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                                <span class="app-sidebar__nav-label">Casos TI</span>
                            </a>
                            <button type="button" class="app-sidebar__nav-chevron" aria-expanded="@(casosTIGroupExpanded ? "true" : "false")" aria-controls="submenu-casos-ti" title="Mostrar/ocultar submenú de Casos TI">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                            </button>
                        </div>
                        <ul class="app-sidebar__submenu" id="submenu-casos-ti">
                            <li>
                                <a class="app-sidebar__submenu-link @(IsActiveAction("CasoTI", "Create") ? "active" : "")" asp-area="" asp-controller="CasoTI" asp-action="Create">Registrar caso</a>
                            </li>
                            <li>
                                <a class="app-sidebar__submenu-link @(!IsActiveAction("CasoTI", "Create") && !IsActiveAction("CasoTI", "Estadisticas") && !IsActiveAction("CasoTI", "Calificaciones") && IsActive("CasoTI") ? "active" : "")" asp-area="" asp-controller="CasoTI" asp-action="Index">Casos</a>
                            </li>
                            <li>
                                <a class="app-sidebar__submenu-link @(IsActiveAction("CasoTI", "Estadisticas") ? "active" : "")" asp-area="" asp-controller="CasoTI" asp-action="Estadisticas">Estadísticas</a>
                            </li>
                            <li>
                                <a class="app-sidebar__submenu-link @(IsActiveAction("CasoTI", "Calificaciones") ? "active" : "")" asp-area="" asp-controller="CasoTI" asp-action="Calificaciones">Calificaciones</a>
                            </li>
                            @if (User.IsInRole("Administrador"))
                            {
                                <li>
                                    <a class="app-sidebar__submenu-link @(IsActive("TipoCaso") ? "active" : "")" asp-area="" asp-controller="TipoCaso" asp-action="Index">Tipos de caso</a>
                                </li>
                            }
                        </ul>
                    </li>
                }
                else
                {
                    <li>
                        <a class="app-sidebar__nav-link @(IsActive("Desktop") ? "active" : "")" asp-area="" asp-controller="Desktop" asp-action="Index" title="Equipos">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
                            <span class="app-sidebar__nav-label">Equipos</span>
                        </a>
                    </li>
                    <li>
                        <a class="app-sidebar__nav-link @(IsActive("Peripheral") ? "active" : "")" asp-area="" asp-controller="Peripheral" asp-action="Index" title="Periféricos">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" /></svg>
                            <span class="app-sidebar__nav-label">Periféricos</span>
                        </a>
                    </li>
                    <li>
                        <a class="app-sidebar__nav-link @(IsActive("MaintenanceCampaign") ? "active" : "")" asp-area="" asp-controller="MaintenanceCampaign" asp-action="Index" title="Mantenimientos Programados">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2" width="6" height="4" rx="1" /><path d="M9 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-3" /><path d="M9 14l2 2 4-4" /></svg>
                            <span class="app-sidebar__nav-label">Mantenimientos Programados</span>
                        </a>
                    </li>
                    <li>
                        <a class="app-sidebar__nav-link @(IsActive("CasoTI") ? "active" : "")" asp-area="" asp-controller="CasoTI" asp-action="Index" title="Casos TI">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                            <span class="app-sidebar__nav-label">Casos TI</span>
                        </a>
                    </li>
                }
                @if (isAdminOrTecnico)
                {
                    <li class="app-sidebar__nav-group @(usuariosGroupExpanded ? "is-expanded" : "")" data-nav-group="usuarios">
                        <div class="app-sidebar__nav-row">
                            <a class="app-sidebar__nav-link @(IsActive("UserAdmin") ? "active" : "")" asp-area="" asp-controller="UserAdmin" asp-action="Index" title="Usuarios">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                                <span class="app-sidebar__nav-label">Usuarios</span>
                            </a>
                            <button type="button" class="app-sidebar__nav-chevron" aria-expanded="@(usuariosGroupExpanded ? "true" : "false")" aria-controls="submenu-usuarios" title="Mostrar/ocultar submenú de Usuarios">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                            </button>
                        </div>
                        <ul class="app-sidebar__submenu" id="submenu-usuarios">
                            <li>
                                <a class="app-sidebar__submenu-link @(IsActive("Remote") ? "active" : "")" asp-area="" asp-controller="Remote" asp-action="Index">Accesos remotos</a>
                            </li>
                            <li>
                                <a class="app-sidebar__submenu-link @(IsActive("Location") ? "active" : "")" asp-area="" asp-controller="Location" asp-action="Index">Áreas y Regionales</a>
                            </li>
                            <li>
                                <a class="app-sidebar__submenu-link @(IsActive("Cargo") ? "active" : "")" asp-area="" asp-controller="Cargo" asp-action="Index">Cargos</a>
                            </li>
                        </ul>
                    </li>
                    @if (User.IsInRole("Administrador"))
                    {
                        <li>
                            <a class="app-sidebar__nav-link @(IsActive("AccessAccount") ? "active" : "")" asp-area="" asp-controller="AccessAccount" asp-action="Index" title="Cuentas de acceso">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                                <span class="app-sidebar__nav-label">Cuentas de acceso</span>
                            </a>
                        </li>
                    }
                }
                else if (!isColaborador)
                {
                    <li>
                        <a class="app-sidebar__nav-link @(IsActive("Remote") ? "active" : "")" asp-area="" asp-controller="Remote" asp-action="Index" title="Accesos remotos">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                            <span class="app-sidebar__nav-label">Accesos remotos</span>
                        </a>
                    </li>
                }
            </ul>

            <div class="app-sidebar__footer">
                <form asp-controller="Login" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="app-sidebar__logout" title="Cerrar sesión">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                        <span class="app-sidebar__nav-label">Cerrar sesión</span>
                    </button>
                </form>
            </div>
        </aside>

        <div class="app-sidebar-backdrop" id="sidebarBackdrop"></div>

        <div class="app-main">
            <div class="app-topbar">
                <button type="button" id="sidebarToggle" class="app-topbar__toggle" aria-label="Alternar menú" aria-expanded="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
                </button>
            </div>

            <main role="main" class="app-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                &copy; 2026 - Gestor_Equipos - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/sidebar.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

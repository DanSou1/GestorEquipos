@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    bool IsActive(params string[] controllers) =>
        controllers.Any(c => string.Equals(c, currentController, StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestor de Equipos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Gestor_Equipos.styles.css" asp-append-version="true" />
</head>
<body class="app-shell">
    <div class="app-layout">
        <aside class="app-sidebar">
            <div class="app-sidebar__logo">
                <img src="~/Images/logo-exro.webp" alt="Exro" />
            </div>

            <div class="app-sidebar__profile">
                <span class="app-sidebar__avatar">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                </span>
                <span>
                    <span class="app-sidebar__profile-name d-block">@User.Identity?.Name</span>
                    <span class="app-sidebar__profile-role">@(User.IsInRole("Administrador") ? "Admin" : "Auditor")</span>
                </span>
            </div>

            <ul class="app-sidebar__nav">
                <li>
                    <a class="app-sidebar__nav-link @(IsActive("Home") ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /></svg>
                        Dashboard
                    </a>
                </li>
                <li>
                    <a class="app-sidebar__nav-link @(IsActive("Desktop") ? "active" : "")" asp-area="" asp-controller="Desktop" asp-action="Index">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
                        Equipos
                    </a>
                </li>
                <li>
                    <a class="app-sidebar__nav-link @(IsActive("Peripheral") ? "active" : "")" asp-area="" asp-controller="Peripheral" asp-action="Index">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" /></svg>
                        Periféricos
                    </a>
                </li>
                @if (User.IsInRole("Administrador"))
                {
                    <li>
                        <a class="app-sidebar__nav-link @(IsActive("UserAdmin") ? "active" : "")" asp-area="" asp-controller="UserAdmin" asp-action="Index">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                            Usuarios
                        </a>
                    </li>
                    <li>
                        <a class="app-sidebar__nav-link @(IsActive("PeripheralType") ? "active" : "")" asp-area="" asp-controller="PeripheralType" asp-action="Index">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" /></svg>
                            Tipos de periférico
                        </a>
                    </li>
                    <li>
                        <a class="app-sidebar__nav-link @(IsActive("Location") ? "active" : "")" asp-area="" asp-controller="Location" asp-action="Index">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
                            Áreas y Regionales
                        </a>
                    </li>
                    <li>
                        <a class="app-sidebar__nav-link @(IsActive("AccessAccount") ? "active" : "")" asp-area="" asp-controller="AccessAccount" asp-action="Index">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                            Cuentas de acceso
                        </a>
                    </li>
                }
            </ul>

            <div class="app-sidebar__footer">
                <form asp-controller="Login" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="app-sidebar__logout">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                        Cerrar sesión
                    </button>
                </form>
            </div>
        </aside>

        <div class="app-main">
            <main role="main" class="app-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                &copy; 2026 - Gestor_Equipos - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

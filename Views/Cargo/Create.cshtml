@model GestorEquipos.Models.ViewModels.Cargo.CargoCreateViewModel
@{
    ViewData["Title"] = "Nuevo cargo";
}

<h1>Nuevo cargo</h1>

<form asp-controller="Cargo" asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Nombre (ej. Técnico en Sistemas, Auxiliar Administrativo)</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-controller="Cargo" asp-action="Index" class="btn btn-link">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@using GestorEquipos.Models.ViewModels.CasoTI
@using Microsoft.AspNetCore.Mvc.Rendering
@model CasoTIRatingsViewModel
@{
    ViewData["Title"] = "Calificaciones de Casos TI";
    SelectList? tecnicoOptions = ViewBag.TecnicoOptions;
    int? tecnicoFiltro = ViewBag.TecnicoFiltro;
}

<div class="section-header">
    <h1>Calificaciones de Casos TI</h1>
</div>

@if (tecnicoOptions is not null)
{
    <form method="get" class="app-toolbar">
        <select name="tecnicoId" class="form-select" style="max-width: 260px;" onchange="this.form.submit()" aria-label="Filtrar por técnico">
            <option value="" selected="@(tecnicoFiltro == null)">Todos los técnicos</option>
            @foreach (var item in tecnicoOptions)
            {
                <option value="@item.Value" selected="@(tecnicoFiltro.HasValue && tecnicoFiltro.Value.ToString() == item.Value)">@item.Text</option>
            }
        </select>
        <button type="submit" class="btn-app-primary">Filtrar</button>
    </form>
}

<div class="app-card mb-3">
    <table class="app-table">
        <thead>
            <tr>
                <th>Técnico</th>
                <th>Promedio</th>
                <th>Casos calificados</th>
                <th>Tiempo promedio de resolución</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Resumen)
            {
                <tr>
                    <td>@r.TecnicoNombre</td>
                    <td>@(r.Promedio.HasValue ? r.Promedio.Value.ToString("0.0") + " / 5" : "-")</td>
                    <td>@r.CantidadCalificados</td>
                    <td>@r.TiempoPromedioResolucionLabel</td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Resumen.Any())
    {
        <p class="text-muted p-3 mb-0">No hay casos resueltos con calificación todavía.</p>
    }
</div>

<div class="charts-row">
    <div class="chart-card">
        <h2 class="chart-card__title">Casos resueltos por técnico y tipo</h2>
        @if (Model.ResueltosPorTipoYTecnico.Series.Any())
        {
            <div class="chart-card__body">
                <div class="chart-card__canvas-wrap chart-card__canvas-wrap--bar">
                    <canvas id="casoTIStackedChart" role="img" aria-label="Casos resueltos por técnico, agrupados por tipo de caso"></canvas>
                </div>
            </div>
            <table class="visually-hidden">
                <caption>Casos resueltos por técnico y tipo</caption>
                <thead>
                    <tr>
                        <th scope="col">Tipo</th>
                        @foreach (var serie in Model.ResueltosPorTipoYTecnico.Series)
                        {
                            <th scope="col">@serie.Label</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.ResueltosPorTipoYTecnico.Labels.Count; i++)
                    {
                        <tr>
                            <td>@Model.ResueltosPorTipoYTecnico.Labels[i]</td>
                            @foreach (var serie in Model.ResueltosPorTipoYTecnico.Series)
                            {
                                <td>@serie.Values[i]</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted mb-0">No hay casos resueltos todavía.</p>
        }
    </div>
    <div class="chart-card">
        <h2 class="chart-card__title">Tiempo promedio de resolución por técnico</h2>
        @if (Model.TiempoPromedioPorTecnicoChart.Values.Any())
        {
            <div class="chart-card__body">
                <div class="chart-card__canvas-wrap chart-card__canvas-wrap--bar">
                    <canvas id="casoTITiempoPromedioChart" role="img" aria-label="Tiempo promedio de resolución por técnico"></canvas>
                </div>
            </div>
            <table class="visually-hidden">
                <caption>Tiempo promedio de resolución por técnico</caption>
                <thead><tr><th scope="col">Técnico</th><th scope="col">Tiempo promedio</th></tr></thead>
                <tbody>
                    @for (var i = 0; i < Model.TiempoPromedioPorTecnicoChart.Labels.Count; i++)
                    {
                        <tr><td>@Model.TiempoPromedioPorTecnicoChart.Labels[i]</td><td>@Model.TiempoPromedioPorTecnicoLabels[i]</td></tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted mb-0">No hay casos resueltos todavía.</p>
        }
    </div>
</div>

<script id="casoTIStackedChartData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
   {
       labels = Model.ResueltosPorTipoYTecnico.Labels,
       series = Model.ResueltosPorTipoYTecnico.Series.Select(s => new { label = s.Label, values = s.Values, color = s.Color })
   }))</script>

<script id="casoTITiempoPromedioChartData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
   {
       labels = Model.TiempoPromedioPorTecnicoChart.Labels,
       values = Model.TiempoPromedioPorTecnicoChart.Values,
       tooltipLabels = Model.TiempoPromedioPorTecnicoLabels
   }))</script>

<h2 class="h5">Comentarios recientes</h2>
<div class="app-card">
    <table class="app-table">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Técnico</th>
                <th>Persona atendida</th>
                <th>Calificación</th>
                <th>Comentario</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Comentarios)
            {
                <tr>
                    <td>@c.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@c.TecnicoNombre</td>
                    <td>@c.PersonaNombre</td>
                    <td>@c.RatingValue / 5</td>
                    <td>@(string.IsNullOrWhiteSpace(c.RatingComment) ? "-" : c.RatingComment)</td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Comentarios.Any())
    {
        <p class="text-muted p-3 mb-0">No hay comentarios registrados.</p>
    }
</div>

@section Scripts {
    <script src="~/lib/chartjs/dist/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/casoti-charts.js" asp-append-version="true"></script>
}

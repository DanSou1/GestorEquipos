@using GestorEquipos.Models
@using GestorEquipos.Models.ViewModels.CasoTI
@using Microsoft.AspNetCore.Mvc.Rendering
@model List<CasoTIListItemViewModel>
@{
    ViewData["Title"] = "Casos TI";
    string? error = ViewBag.Error;
    string? success = ViewBag.Success;
    SelectList? tecnicoOptions = ViewBag.TecnicoOptions;
    SelectList? tipoCasoOptions = ViewBag.TipoCasoOptions;
    CasoTIIndexFilterViewModel filter = ViewBag.Filter ?? new CasoTIIndexFilterViewModel();
    bool canCreate = User.IsInRole("Administrador") || User.IsInRole("Técnico en Sistemas") || User.IsInRole("Colaborador");
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}
@if (!string.IsNullOrWhiteSpace(success))
{
    <div class="alert alert-success">@success</div>
}

<div class="section-header">
    <h1>Casos TI</h1>
    @if (canCreate)
    {
        <a asp-controller="CasoTI" asp-action="Create" class="btn-app-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
            Registrar caso
        </a>
    }
</div>

<form method="get" class="app-toolbar flex-wrap gap-2">
    <input type="text" name="Asunto" value="@filter.Asunto" class="form-control" style="max-width: 200px;" placeholder="Asunto" />
    <input type="text" name="PersonaNombre" value="@filter.PersonaNombre" class="form-control" style="max-width: 200px;" placeholder="Persona" />
    <input type="date" name="FechaDesde" value="@(filter.FechaDesde?.ToString("yyyy-MM-dd"))" class="form-control" style="max-width: 160px;" title="Desde" />
    <input type="date" name="FechaHasta" value="@(filter.FechaHasta?.ToString("yyyy-MM-dd"))" class="form-control" style="max-width: 160px;" title="Hasta" />
    <select name="Estado" class="form-select" style="max-width: 160px;">
        <option value="">Todos los estados</option>
        <option value="@((int)CasoTIEstado.Abierto)" selected="@(filter.Estado == CasoTIEstado.Abierto)">Abierto</option>
        <option value="@((int)CasoTIEstado.Resuelto)" selected="@(filter.Estado == CasoTIEstado.Resuelto)">Resuelto</option>
    </select>
    @if (tipoCasoOptions is not null)
    {
        <select name="TipoCasoId" class="form-select" style="max-width: 200px;">
            <option value="">Todos los tipos</option>
            @foreach (var item in tipoCasoOptions)
            {
                <option value="@item.Value" selected="@(filter.TipoCasoId.HasValue && filter.TipoCasoId.Value.ToString() == item.Value)">@item.Text</option>
            }
        </select>
    }
    @if (tecnicoOptions is not null)
    {
        <select name="TecnicoUserSystemId" class="form-select" style="max-width: 220px;">
            <option value="">Todos los técnicos</option>
            @foreach (var item in tecnicoOptions)
            {
                <option value="@item.Value" selected="@(filter.TecnicoUserSystemId.HasValue && filter.TecnicoUserSystemId.Value.ToString() == item.Value)">@item.Text</option>
            }
        </select>
    }
    <button type="submit" class="btn-app-primary">Filtrar</button>
    <a asp-controller="CasoTI" asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
</form>

<div class="app-card">
    <table class="app-table">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Asunto</th>
                <th>Técnico</th>
                <th>Persona atendida</th>
                <th>Área</th>
                <th>Tipo de caso</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@c.Asunto</td>
                    <td>@c.TecnicoNombre</td>
                    <td>@c.PersonaNombre</td>
                    <td>@(c.AreaSnapshot ?? "-")</td>
                    <td>@c.TipoCasoNombre</td>
                    <td>
                        @if (c.Estado == CasoTIEstado.Resuelto)
                        {
                            <span class="badge bg-success">Resuelto</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Abierto</span>
                        }
                    </td>
                    <td class="text-nowrap">
                        <a asp-controller="CasoTI" asp-action="Details" asp-route-id="@c.Id">Ver</a>
                        @if (c.CanDelete)
                        {
                            <form asp-controller="CasoTI" asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline ms-2" onsubmit="return confirm('¿Eliminar este caso?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-link text-danger p-0">Eliminar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <p class="text-muted p-3 mb-0">No hay casos TI registrados.</p>
    }
</div>

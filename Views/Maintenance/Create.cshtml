@model MaintenanceCreateViewModel
@{
    ViewData["Title"] = "Registrar mantenimiento";
}

<h1>Registrar mantenimiento</h1>

<form asp-controller="Maintenance" asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="DesktopId" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="MaintenanceTypeId" class="form-label">Tipo de mantenimiento</label>
        <select asp-for="MaintenanceTypeId" class="form-select" asp-items="ViewBag.MaintenanceTypes">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="MaintenanceTypeId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Date" class="form-label"></label>
        <input asp-for="Date" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="TechnicianName" class="form-label">Técnico</label>
        <input asp-for="TechnicianName" type="text" class="form-control" />
        <span asp-validation-for="TechnicianName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label">Observación</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-controller="Desktop" asp-action="Details" asp-route-id="@Model.DesktopId" class="btn btn-link">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model GestorEquipos.Models.Auth.ChangePasswordViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="section-header">
    <h1>Cambiar contraseña</h1>
</div>

<div class="app-card p-4">
    <p class="text-muted">Debes cambiar tu contraseña temporal antes de continuar.</p>
    <form asp-controller="ChangePassword" asp-action="Index" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn-app-primary">Guardar contraseña</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
